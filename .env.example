# TRACE 환경변수 예시 — 실제 값은 여기 넣지 말고 .env(gitignore)에 넣으세요.
# (NFR-SEC-001: 키 값은 코드/설정/저장소에 평문 저장 금지, 환경변수로만 주입)

# ── 백엔드 선택 ── anthropic(기본, 1st-party API) | bedrock(Amazon Bedrock)
TRACE_LLM_PROVIDER=anthropic

# [provider=anthropic] Anthropic Claude API 키 (소비 직전 이 변수에서 조회)
ANTHROPIC_API_KEY=

# [provider=bedrock] AWS 자격증명은 표준 체인에서 조회 — 아래를 .env 또는 셸에 지정
#   pip install 'anthropic[bedrock]' (또는 pip install -e '.[bedrock]') 필요
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # (임시 자격증명 사용 시)
# AWS_REGION=us-east-1         # 또는 TRACE_BEDROCK_REGION
# TRACE_LLM_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0   # Bedrock 모델 ID/inference profile (bedrock 필수)

# (선택) 로그 레벨: DEBUG / INFO / WARNING / ERROR — 기본 INFO
TRACE_LOG_LEVEL=INFO

# (선택) 분석 대상 프로젝트 루트 — 미지정 시 서버/CLI 실행 디렉터리(cwd) 사용
TRACE_PROJECT_ROOT=
