# TRACE 환경 설정 예시 — 이 파일을 `.env`로 복사해 값을 채우세요. `.env`는 커밋되지 않습니다.

# Anthropic Claude API 키 (live LLM 백엔드에서만 필요). NFR-SEC-001: 코드에 하드코딩 금지.
ANTHROPIC_API_KEY=sk-ant-...

# LLM 백엔드 선택: "live" | "bedrock" | "replay"  (기본 replay = API 키 없이 결정적 데모 재현)
TRACE_LLM_BACKEND=replay

# 사용할 Claude 모델 (live 모드, Anthropic 다이렉트 ID)
TRACE_LLM_MODEL=claude-sonnet-5

# --- Amazon Bedrock 백엔드 (TRACE_LLM_BACKEND=bedrock 일 때) ---
# Bedrock은 sk-ant 키가 아니라 Bedrock API 키(bearer 토큰, ABSK…)를 쓴다.
# AWS_BEARER_TOKEN_BEDROCK=ABSK...
# AWS_REGION=ap-northeast-2
# Bedrock 모델/추론 프로파일 ID (리전에 맞는 접두사: us. / eu. / apac.)
# TRACE_BEDROCK_MODEL=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
# 주의: IAM 사용자에 bedrock:InvokeModel 권한 + Bedrock 콘솔에서 해당 모델 액세스 활성화 필요.

# replay 백엔드가 사전 응답을 읽는 디렉터리 (미설정 시 데모 픽스처 사용)
# TRACE_REPLAY_DIR=/path/to/replay/fixtures

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
TRACE_LOG_LEVEL=INFO
